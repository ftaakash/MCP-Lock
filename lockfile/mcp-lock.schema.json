{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ftaakash/mcp-lock/lockfile/mcp-lock.schema.json",
  "title": "MCP-Lock lockfile (DRAFT v0.2)",
  "description": "Pins every MCP server launched by an agent harness to an exact package version, archive digest, provenance identity and tool-definition hash.",
  "type": "object",
  "required": [
    "lockfileVersion",
    "servers"
  ],
  "additionalProperties": false,
  "properties": {
    "lockfileVersion": {
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "generated": {
      "type": "string",
      "format": "date-time"
    },
    "servers": {
      "type": "object",
      "description": "Keyed by the server id used in the harness config (e.g. the key under mcpServers).",
      "additionalProperties": {
        "$ref": "#/$defs/server"
      }
    },
    "skipped": {
      "type": "object",
      "description": "Config entries not locked (remote URL servers, non-runner launches), with the reason.",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "server": {
      "type": "object",
      "required": [
        "ecosystem",
        "name",
        "version",
        "integrity",
        "tools"
      ],
      "additionalProperties": false,
      "properties": {
        "ecosystem": {
          "enum": [
            "npm",
            "pypi"
          ]
        },
        "name": {
          "type": "string",
          "description": "Registry package name (npm name or PEP 503-normalized PyPI name)."
        },
        "version": {
          "type": "string",
          "description": "Exact resolved version; never a range or dist-tag."
        },
        "launch": {
          "type": "object",
          "description": "The launch line as declared, for drift detection of the config itself.",
          "properties": {
            "runner": {
              "enum": [
                "npx",
                "pnpx",
                "bunx",
                "uvx",
                "uv tool run",
                "pipx run"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "integrity": {
          "type": "string",
          "pattern": "^(sha512|sha256)-.+$",
          "description": "Archive digest: npm dist.integrity (sha512, SRI) or PyPI file sha256."
        },
        "archive": {
          "type": "string",
          "description": "Archive filename (PyPI) or tarball URL (npm)."
        },
        "provenance": {
          "description": "Build identity from a verified attestation, or null if the version had none.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "predicateType",
                "sourceRepository",
                "workflowPath",
                "builder",
                "digest"
              ],
              "properties": {
                "predicateType": {
                  "type": "string"
                },
                "sourceRepository": {
                  "type": "string",
                  "description": "e.g. https://github.com/owner/repo"
                },
                "sourceRef": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "sourceCommit": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    }
                  ]
                },
                "workflowPath": {
                  "type": "string",
                  "description": "e.g. .github/workflows/release.yml"
                },
                "builder": {
                  "type": "string",
                  "description": "Builder id, e.g. GitHub Actions hosted runner."
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "description": "sha256 over the continuity identity [sourceRepository, workflowPath, builder]."
                },
                "environment": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "publisher": {
          "type": "object",
          "description": "Registry account identity at lock time (S3 maintainer-change signal).",
          "properties": {
            "publisher": {
              "type": [
                "string",
                "null"
              ]
            },
            "maintainers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "installScripts": {
          "type": "array",
          "items": {
            "enum": [
              "preinstall",
              "install",
              "postinstall",
              "prepare",
              "setup.py"
            ]
          },
          "description": "Install-time hooks present at lock time (S4 new-install-script signal)."
        },
        "tools": {
          "type": "object",
          "required": [
            "hash",
            "method"
          ],
          "properties": {
            "hash": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              ],
              "description": "sha256 over the sorted canonical (name, description, schema) list; null if no tool definitions could be extracted."
            },
            "method": {
              "enum": [
                "static",
                "dynamic"
              ],
              "description": "static = extracted from the archive; dynamic = tools/list in a network-less sandbox."
            },
            "names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "runtime": {
              "type": "object",
              "description": "v0.2, exploratory H2: the live tools/list pinned by the MCP proxy (`mcplock proxy --record`).",
              "required": [
                "hash",
                "tools"
              ],
              "properties": {
                "hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "tools": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                },
                "recorded": {
                  "type": "string"
                }
              }
            }
          }
        },
        "dependencies": {
          "type": "object",
          "description": "v0.2, npm, exploratory H1: every node of the dependency tree resolved at lock time.",
          "required": [
            "nodes"
          ],
          "properties": {
            "nodes": {
              "type": "object",
              "description": "Keyed by name@version.",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "integrity"
                ],
                "properties": {
                  "integrity": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "provenance": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "publisher": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "maintainers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "installScripts": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "unresolved": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "files": {
          "type": "object",
          "description": "v0.2, PyPI, exploratory H3: digest of every file of the release at lock time, keyed by file name.",
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256-[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
